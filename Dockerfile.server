FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY app/server/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

COPY app/__init__.py /app/__init__.py
COPY app/main.py /app/main.py
COPY app/server /app/server

# Crear directorios internos
RUN mkdir -p /app/files /app/logs /tmp/source_files

# Los logs sí se mantienen como volumen persistente
VOLUME ["/app/logs"]

# Copiar y dar permisos al script de entrada
COPY app/server/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONPATH=/app
ENV FILES_ROOT=/app/files
ENV FILES_SOURCE_PATH=/tmp/source_files

EXPOSE 8000

# Usar el script de entrada que copia archivos antes de iniciar
ENTRYPOINT ["/app/entrypoint.sh"]
