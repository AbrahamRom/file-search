# ============================================================================
# Processor Node Dockerfile
# Stateless processing layer - coordinates with Storage Nodes
# ============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install requirements
COPY app/processor/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Copy application code
COPY app/__init__.py /app/__init__.py
COPY app/common /app/common
COPY app/processor /app/processor

# Create log directory
RUN mkdir -p /app/logs /tmp/dns-cache

# Logs volume for persistent logging
VOLUME ["/app/logs"]

# Copy and set permissions for entrypoint
COPY app/processor/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Environment configuration
ENV PYTHONPATH=/app
ENV PROCESSOR_PORT=8000

EXPOSE 8000

# Use entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]
